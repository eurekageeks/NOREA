# ─────────────────────────────────────────────────────────────
#  NŌRÉA API – environment configuration
#  Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5050

# Comma-separated list of allowed browser origins (CORS)
CLIENT_ORIGIN=http://localhost:5173
# Public URL of the website (used in sitemap.xml / robots.txt)
SITE_URL=http://localhost:5173

# MySQL 8+
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=norea_app
DB_PASSWORD=change-me
DB_NAME=norea_learning
DB_POOL_SIZE=10

# JWT – use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=replace-with-a-64-char-random-secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_DAYS=7

# Cookies are marked `Secure` automatically in production (HTTPS required).
# COOKIE_SECURE=true

BCRYPT_ROUNDS=12
UPLOAD_MAX_MB=3

# Behind nginx / a load balancer in production
# TRUST_PROXY=1

# Serve frontend/dist from this server (single-server deployment)
SERVE_FRONTEND=false

# Used only by `npm run db:admin` to create the first super admin
ADMIN_NAME=NŌRÉA Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
