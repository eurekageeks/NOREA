# Base URL of the API. Leave empty in development (Vite proxies /api → backend)
# and when the API is served from the same domain in production.
# Example for a separate API domain: https://api.yourdomain.com
VITE_API_URL=

# Public site URL (canonical links / Open Graph)
VITE_SITE_URL=http://localhost:5173

# Dev only: where Vite proxies /api and /uploads
VITE_DEV_API_PROXY=http://127.0.0.1:5050
