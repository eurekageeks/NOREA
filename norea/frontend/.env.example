# WhatsApp & Email Notification Settings (set in Vercel → Settings → Environment Variables)
# 1. WhatsApp (your institute WhatsApp number with country code, digits only, e.g. 919876543210)
VITE_WHATSAPP_NUMBER=

# 2. Automatic Email – choose ANY ONE of these free options:
# Option A (Recommended – sends directly to student's inbox from frontend): https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Option B (Zero signup – sends to your institute email + auto-reply to student):
VITE_INSTITUTE_EMAIL=

# Option C (Free access key from https://web3forms.com/):
VITE_WEB3FORMS_KEY=
